# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Flask session encryption key - generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<your-random-secret-key>

# Frontend origin allowed by CORS
FRONTEND_URL=http://localhost:5173

# Set to "development" for debug mode (defaults to production)
FLASK_ENV=development

# Public site URL used for the dynamic sitemap
SITE_URL=https://www.dipendrakumaryadav.com.np
